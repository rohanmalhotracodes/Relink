# FalkorDB connection. Docker Compose exposes the database on port 6379.
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_BROWSER_PORT=3001
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_GRAPH=relink_jaffle
WAREHOUSE_DIR=demo-jaffle
NAMESPACE_PREFIX=jaffle_shop.
FALKORDB_SSL=false

# Optional. This is the only Groq credential required. Without it, all graph
# reasoning, patching, and validation still run in deterministic mode.
GROQ_API_KEY=

# Optional application overrides (the defaults are shown).
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_MAX_TOOL_STEPS=8

# Safe by default for CLI/UI runs. A signed pull-request webhook may write only
# the validated repair to that PR's existing source branch through the App.
REPAIR_AGENT_PR_MODE=dry-run

# Demo repository. Dry-run mode only uses this as the label on local GitHub
# simulations; no GitHub API call is made.
GITHUB_REPOSITORY=rohanmalhotracodes/jaffle_shop_duckdb
GITHUB_ISSUE_NUMBER=
GITHUB_COMMENT_MODE=dry-run
REPAIR_AGENT_PUBLIC_URL=http://localhost:3002

# Optional real GitHub App integration. Register an app, install it only on the
# demo fork, grant Contents/Issues/Pull requests read/write, subscribe to Issues
# and Pull requests, and point its webhook URL at /api/github/webhook through an
# HTTPS tunnel. Keep the PEM file outside git.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
# Deployment alternative: store the complete PEM as a secret environment
# variable instead of mounting a key file. Never set both or commit this value.
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# Demo-only: when a signed issue/PR arrives and the graph is clean, apply this
# controlled warehouse drift before starting the investigation.
GITHUB_AUTO_DEMO_SCENARIO=rename_jaffle_user_id
API_PORT=8002

# Optional landing-page contact recipient. When configured, the contact form
# opens the visitor's email client with the message addressed to this inbox.
VITE_CONTACT_EMAIL=
